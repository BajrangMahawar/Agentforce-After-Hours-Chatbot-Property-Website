        Get_Mediator:
            label: "Get Mediator"
            description: "Get Mediator"
            target: "apex://AgentforceMediatorController"
            inputs:
                durationMinutes: integer
                    label: "Duration (Minutes)"
                    description: "Slot length when no End Time is given. Defaults to 60."
                    is_required: False
                endTime: object
                    label: "End Time"
                    description: "Requested site-visit end. Leave blank to use Duration (Minutes) instead."
                    is_required: True
                    complex_data_type_name: "lightning__dateTimeStringType"
                propertyId: string
                    label: "Property Id"
                    description: "Id of the property the visitor asked about. Preferred over the name."
                    is_required: False
                propertyName: string
                    label: "Property Name"
                    description: "Project name, used only when no Property Id is known. Partial names are matched."
                    is_required: True
                startTime: object
                    label: "Start Time"
                    description: "Requested site-visit start date and time. Required."
                    is_required: True
                    complex_data_type_name: "lightning__dateTimeStringType"
            outputs:
                isSuccess: boolean
                    label: "Success"
                    description: ""
                    is_displayable: False
                    filter_from_agent: False
                mediatorCount: integer
                    label: "Mediator Count"
                    description: ""
                    is_displayable: True
                    filter_from_agent: False
                mediators: list[object]
                    label: "Mediators"
                    description: "Mediators free for the requested slot. Empty when nobody is available."
                    complex_data_type_name: "@apexClassType/c__AgentforceMediatorController$MediatorInfo"
                    is_displayable: True
                    filter_from_agent: False
                message: string
                    label: "Message"
                    description: "Human readable outcome the agent can say out loud."
                    is_displayable: True
                    filter_from_agent: False

        Create_Service_Appointment:
            label: "Create Service Appointment"
            description: "Create Service Appointment"
            target: "apex://AgentforceSiteVisitController"
            inputs:
                customerEmail: string
                    label: "Customer Email"
                    description: "Customer Email"
                    is_required: True
                customerName: string
                    label: "Customer Name"
                    description: "Visitor name. Falls back to the email handle when blank."
                    is_required: True
                customerPhone: string
                    label: "Customer Phone"
                    description: "Customer Phone"
                    is_required: True
                durationMinutes: integer
                    label: "Duration (Minutes)"
                    description: "Slot length when no End Time is given. Defaults to 60."
                    is_required: False
                endTime: object
                    label: "End Time"
                    description: "Leave blank to use Duration (Minutes) instead."
                    is_required: True
                    complex_data_type_name: "lightning__dateTimeStringType"
                mediatorId: string
                    label: "Mediator Id"
                    description: "Contact Id of the mediator taking the visit. Preferred over the name."
                    is_required: False
                mediatorName: string
                    label: "Mediator Name"
                    description: "Mediator name, used when no Mediator Id is known."
                    is_required: True
                parentRecordId: string
                    label: "Parent Record Id"
                    description: "Optional. Overrides the Lead the appointment is filed under."
                    is_required: False
                propertyId: string
                    label: "Property Id"
                    description: "Id of the property being visited. Preferred over the name."
                    is_required: False
                propertyName: string
                    label: "Property Name"
                    description: "Project name, used when no Property Id is known."
                    is_required: True
                startTime: object
                    label: "Start Time"
                    description: "Requested site-visit date and time. Required."
                    is_required: True
                    complex_data_type_name: "lightning__dateTimeStringType"
            outputs:
                appointmentNumber: string
                    label: "Appointment Number"
                    description: "The booking reference to read back to the visitor."
                    is_displayable: True
                    filter_from_agent: False
                isSuccess: boolean
                    label: "Success"
                    description: "True only when the appointment was actually created."
                    is_displayable: False
                    filter_from_agent: False
                leadId: string
                    label: "Lead Id"
                    description: "The visitor captured for follow-up."
                    is_displayable: False
                    filter_from_agent: False
                mediatorId: string
                    label: "Mediator Id"
                    description: ""
                    is_displayable: False
                    filter_from_agent: False
                mediatorName: string
                    label: "Mediator Name"
                    description: ""
                    is_displayable: True
                    filter_from_agent: False
                message: string
                    label: "Message"
                    description: "Human readable outcome the agent can say out loud."
                    is_displayable: True
                    filter_from_agent: False
                propertyId: string
                    label: "Property Id"
                    description: ""
                    is_displayable: False
                    filter_from_agent: False
                propertyName: string
                    label: "Property Name"
                    description: "Property Name"
                    is_displayable: True
                    filter_from_agent: False
                scheduledEnd: object
                    label: "Scheduled End"
                    description: "Scheduled End"
                    complex_data_type_name: "lightning__dateTimeStringType"
                    is_displayable: True
                    filter_from_agent: False
                scheduledStart: object
