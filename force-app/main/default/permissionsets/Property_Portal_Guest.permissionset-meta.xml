<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Property Portal Guest</label>
    <description>Read-only portfolio access for the Real Estate Property Portal site guest user. Without this the public page renders an empty collection and the chat window answers with nothing - assign it to the site's guest user.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <classAccesses><apexClass>PropertyPortalController</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>PropertyChatController</apexClass><enabled>true</enabled></classAccesses>

    <objectPermissions>
        <object>Property__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <!-- The chat detail card shows unit plans and amenities under the photographs. -->
    <objectPermissions>
        <object>Property_Specification__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <fieldPermissions><field>Property_Specification__c.Amenities__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Property_Specification__c.Built_up_Area__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Property_Specification__c.Carpet_Area__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Property_Specification__c.Floor_Plan_URL__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <!-- Unit_Type__c is a required field, so its read access comes with the
         object and cannot be granted here - the platform rejects the entry. -->
    <fieldPermissions><field>Property__c.Address__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Property__c.City__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Property__c.Configurations__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Property__c.Description__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Property__c.Possession_Date__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Property__c.Price_Max__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Property__c.Price_Min__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Property__c.Price_Range__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Property__c.Property_Type__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Property__c.RERA_Number__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Property__c.Status__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
</PermissionSet>
